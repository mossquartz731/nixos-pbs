@@ -202,9 +202,31 @@ fn upgrade_to_backup_protocol(
 
         let (path, is_new, snap_guard) =
             datastore.create_locked_backup_dir(backup_dir.backup_ns(), backup_dir.as_ref())?;
-        if !is_new {
-            bail!("backup directory already exists.");
-        }
+        let (path, snap_guard) = if is_new {
+            (path, snap_guard)
+        } else {
+            let existing = BackupInfo::new(backup_dir.clone())?;
+            if existing.is_finished() {
+                bail!("backup directory already exists.");
+            }
+
+            // A failed S3 upload can leave the local cache directory behind when the backend is
+            // unavailable during cleanup. The directory has no manifest, so it is safe to retry
+            // its native removal once the backend is reachable again. Without this, push sync
+            // treats the unfinished timestamp as current and never retries the snapshot.
+            drop(snap_guard);
+            warn!("removing incomplete backup directory before retry: {backup_dir:?}");
+            datastore
+                .delete_snapshot(&backup_dir)
+                .context("failed to remove incomplete backup directory before retry")?;
+
+            let (path, is_new, snap_guard) =
+                datastore.create_locked_backup_dir(backup_dir.backup_ns(), backup_dir.as_ref())?;
+            if !is_new {
+                bail!("unable to recreate incomplete backup directory.");
+            }
+            (path, snap_guard)
+        };
 
